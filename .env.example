# Public site URL (used for auth redirects and public links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (from Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
# The new publishable key (starts with sb_publishable_...). Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The new secret key (starts with sb_secret_...). Server-only. Never expose it.
SUPABASE_SECRET_KEY=

# Postgres connection string for Drizzle (from Project Settings -> Database)
# Use the direct/pooled connection string with sslmode=require
DATABASE_URL=

# --- AI assistant (server-only; never expose these to the browser) ---------
# Current provider: Google Gemini. The provider is swappable in server/container.ts
# without touching domain/application logic.
# Gemini API key used for structured estimate extraction.
GEMINI_API_KEY=
# Model for extraction (must support structured JSON output).
AI_EXTRACTION_MODEL=gemini-3.5-flash-lite
# Transcription model (used later for the voice flow).
AI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Optional override for the Gemini base URL.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Embedding model for semantic catalog matching (output dimensionality below).
AI_EMBEDDING_MODEL=gemini-embedding-2
AI_EMBEDDING_DIMENSIONS=768
# Enable the optional LLM rerank step over retrieved candidates ("true" to turn on).
AI_RERANK_ENABLED=false
